{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Full System (FastAPI + Streamlit)",
      "type": "shell",
      "command": "python",
      "args": ["run.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Run Pytest Tests",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest", "-v"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Benchmark Evaluation",
      "type": "shell",
      "command": "python",
      "args": ["scripts/evaluate_chatbot.py"],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
