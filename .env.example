# ==============================================================================
# Environment Configuration - Internship Application Agent Product Assistant
# ==============================================================================

# LLM Provider Configuration ("gemini", "openai", or "mock")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys (Provide at least one if LLM_PROVIDER is not mock)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./vector_store
CHROMA_COLLECTION_NAME=internship_agent_knowledge
RETRIEVAL_TOP_K=4
SIMILARITY_SCORE_THRESHOLD=0.15

# Conversational Memory & Database
SQLITE_DB_PATH=./app/database/conversations.db
MAX_HISTORY_MESSAGES=6

# Knowledge Base Directory
KNOWLEDGE_BASE_DIR=./knowledge_base
